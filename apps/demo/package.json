{
  "name": "@foldworks/demo",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && vite build --config vite.mcp-app.config.ts",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run src",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "test:visual": "playwright test --config playwright.visual.config.ts",
    "test:visual:update": "playwright test --config playwright.visual.config.ts --update-snapshots"
  },
  "dependencies": {
    "@foldkit/markdown": "catalog:",
    "@foldkit/ui": "catalog:",
    "@lucide/icons": "catalog:",
    "@modelcontextprotocol/ext-apps": "catalog:",
    "@stylexjs/stylex": "catalog:",
    "effect": "catalog:",
    "foldkit": "catalog:",
    "foldworks": "workspace:*",
    "pdf-lib": "catalog:",
    "pdfjs-dist": "catalog:"
  },
  "devDependencies": {
    "@effect/platform-browser": "catalog:",
    "@foldkit/devtools": "catalog:",
    "@foldkit/vite-plugin": "catalog:",
    "@playwright/test": "catalog:",
    "@stylexjs/unplugin": "catalog:",
    "@types/node": "catalog:",
    "dejavu-fonts-ttf": "catalog:",
    "inter-font": "catalog:",
    "playwright": "catalog:",
    "typescript": "catalog:",
    "typescript-api": "npm:typescript@^5.9.3",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
