{
  "name": "@foldworks/demo",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && vite build --config vite.mcp-app.config.ts",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run src",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "test:visual": "playwright test --config playwright.visual.config.ts",
    "test:visual:update": "playwright test --config playwright.visual.config.ts --update-snapshots"
  },
  "dependencies": {
    "@foldkit/markdown": "catalog:",
    "@foldkit/ui": "catalog:",
    "@foldworks/agent": "workspace:*",
    "@foldworks/code-editor": "workspace:*",
    "@foldworks/data-grid": "workspace:*",
    "@foldworks/data-table": "workspace:*",
    "@foldworks/diagram": "workspace:*",
    "@foldworks/diff-viewer": "workspace:*",
    "@foldworks/editor": "workspace:*",
    "@foldworks/form-builder": "workspace:*",
    "@foldworks/generative-ui": "workspace:*",
    "@foldworks/history": "workspace:*",
    "@foldworks/outliner": "workspace:*",
    "@foldworks/pdf": "workspace:*",
    "@foldworks/pdf-annotator": "workspace:*",
    "@foldworks/pdf-viewer": "workspace:*",
    "@foldworks/query-builder": "workspace:*",
    "@foldworks/sidebar": "workspace:*",
    "@foldworks/ui": "workspace:*",
    "@foldworks/workflow": "workspace:*",
    "@lucide/icons": "catalog:",
    "@stylexjs/stylex": "catalog:",
    "effect": "catalog:",
    "foldkit": "catalog:",
    "pdf-lib": "catalog:"
  },
  "devDependencies": {
    "@foldkit/devtools": "catalog:",
    "@foldkit/vite-plugin": "catalog:",
    "@playwright/test": "catalog:",
    "@stylexjs/unplugin": "catalog:",
    "@types/node": "catalog:",
    "dejavu-fonts-ttf": "catalog:",
    "inter-font": "catalog:",
    "playwright": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
