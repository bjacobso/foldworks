{
  "name": "@foldworks/query-builder",
  "version": "0.1.1",
  "description": "A controlled recursive query builder with validation and structured drag and drop.",
  "license": "MIT",
  "author": "Ben Jacobson",
  "type": "module",
  "files": ["dist", "README.md", "LICENSE"],
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bjacobso/foldworks.git",
    "directory": "packages/query-builder"
  },
  "homepage": "https://github.com/bjacobso/foldworks#readme",
  "bugs": { "url": "https://github.com/bjacobso/foldworks/issues" },
  "keywords": ["foldkit", "query-builder", "filters", "drag-and-drop", "stylex"],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "node ../../scripts/build-package.mjs",
    "prepack": "pnpm run build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@foldkit/ui": "catalog:",
    "@lucide/icons": "catalog:",
    "@foldworks/ui": "workspace:*",
    "@stylexjs/stylex": "catalog:",
    "effect": "catalog:",
    "foldkit": "catalog:"
  },
  "devDependencies": {
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
