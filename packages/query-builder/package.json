{
  "name": "@foldworks/query-builder",
  "version": "0.1.0",
  "description": "A controlled recursive query builder with validation and structured drag and drop.",
  "license": "MIT",
  "author": "Ben Jacobson",
  "type": "module",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bjacobso/foldworks.git",
    "directory": "packages/query-builder"
  },
  "homepage": "https://github.com/bjacobso/foldworks#readme",
  "bugs": {
    "url": "https://github.com/bjacobso/foldworks/issues"
  },
  "keywords": [
    "foldkit",
    "query-builder",
    "filters",
    "drag-and-drop",
    "stylex"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "node ../../scripts/build-package.mjs",
    "build:runtime": "node ../../scripts/build-package.mjs --runtime-only",
    "prepack": "pnpm run build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@lucide/icons": "catalog:",
    "@foldworks/ui": "workspace:*"
  },
  "devDependencies": {
    "@foldkit/ui": "catalog:",
    "@stylexjs/stylex": "catalog:",
    "effect": "catalog:",
    "foldkit": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "@foldkit/ui": "catalog:peers",
    "@stylexjs/stylex": "catalog:peers",
    "effect": "catalog:peers",
    "foldkit": "catalog:peers"
  }
}
