{
  "name": "@foldworks/sidebar",
  "version": "0.1.0",
  "description": "Responsive controlled application chrome and navigation for Foldkit and StyleX.",
  "license": "MIT",
  "author": "Ben Jacobson",
  "type": "module",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bjacobso/foldworks.git",
    "directory": "packages/sidebar"
  },
  "homepage": "https://github.com/bjacobso/foldworks#readme",
  "bugs": {
    "url": "https://github.com/bjacobso/foldworks/issues"
  },
  "keywords": [
    "foldkit",
    "sidebar",
    "navigation",
    "application-shell",
    "stylex"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "node ../../scripts/build-package.mjs",
    "build:runtime": "node ../../scripts/build-package.mjs --runtime-only",
    "prepack": "pnpm run build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@foldworks/ui": "workspace:*",
    "@lucide/icons": "catalog:"
  },
  "devDependencies": {
    "@stylexjs/stylex": "catalog:",
    "effect": "catalog:",
    "foldkit": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "@stylexjs/stylex": "catalog:peers",
    "effect": "catalog:peers",
    "foldkit": "catalog:peers"
  }
}
