{
  "name": "@foldworks/ui",
  "version": "0.2.0",
  "description": "Themeable, accessible UI components for Foldkit applications styled with StyleX.",
  "license": "MIT",
  "author": "Ben Jacobson",
  "type": "module",
  "files": [
    "dist",
    "docs",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bjacobso/foldworks.git",
    "directory": "packages/ui"
  },
  "homepage": "https://github.com/bjacobso/foldworks#readme",
  "bugs": {
    "url": "https://github.com/bjacobso/foldworks/issues"
  },
  "keywords": [
    "foldkit",
    "ui",
    "components",
    "accessibility",
    "stylex"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./icon": {
      "types": "./dist/icon.d.ts",
      "import": "./dist/icon.js"
    },
    "./tokens.stylex": {
      "types": "./dist/tokens.stylex.d.ts",
      "import": "./dist/tokens.stylex.js"
    },
    "./theme.css": "./dist/theme.css",
    "./base.css": "./dist/base.css",
    "./themes/shadcn.css": "./dist/themes/shadcn.css",
    "./themes/blueprint.css": "./dist/themes/blueprint.css",
    "./themes/office.css": "./dist/themes/office.css",
    "./themes/google.css": "./dist/themes/google.css",
    "./themes/apple.css": "./dist/themes/apple.css",
    "./themes/polaris.css": "./dist/themes/polaris.css"
  },
  "scripts": {
    "build": "node ../../scripts/build-package.mjs",
    "build:runtime": "node ../../scripts/build-package.mjs --runtime-only",
    "prepack": "pnpm run build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@foldworks/keyboard": "workspace:*",
    "@lucide/icons": "catalog:"
  },
  "devDependencies": {
    "@foldkit/ui": "catalog:",
    "@stylexjs/stylex": "catalog:",
    "@types/node": "catalog:",
    "effect": "catalog:",
    "foldkit": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "@foldkit/ui": "catalog:peers",
    "@stylexjs/stylex": "catalog:peers",
    "effect": "catalog:peers",
    "foldkit": "catalog:peers"
  }
}
