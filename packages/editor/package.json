{
  "name": "@foldworks/editor",
  "version": "0.0.0",
  "description": "Native Foldkit rich-text editing, Markdown codecs, and extensible document blocks.",
  "license": "MIT",
  "author": "Ben Jacobson",
  "type": "module",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bjacobso/foldworks.git",
    "directory": "packages/editor"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css"
  },
  "scripts": {
    "build": "node ../../scripts/build-package.mjs",
    "prepack": "pnpm run build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "effect": "catalog:",
    "foldkit": "catalog:",
    "unified": "^11.0.5",
    "remark-parse": "^11.0.0",
    "remark-stringify": "^11.0.0",
    "remark-gfm": "^4.0.1",
    "remark-directive": "^4.0.0"
  },
  "devDependencies": {
    "@types/mdast": "^4.0.4",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
