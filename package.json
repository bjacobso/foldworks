{
  "name": "foldworks",
  "private": true,
  "packageManager": "pnpm@10.20.0",
  "engines": {
    "node": ">=24.13",
    "pnpm": ">=10.20"
  },
  "scripts": {
    "dev": "pnpm --filter @foldworks/example dev",
    "build": "pnpm --filter @foldworks/example build",
    "typecheck": "pnpm --recursive --if-present typecheck",
    "test": "pnpm --recursive --if-present test",
    "test:e2e": "pnpm --filter @foldworks/example test:e2e"
  }
}
